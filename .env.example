# .env.example
# Primary AI Provider ('nvidia' as default, with fallback to 'gemini')
AI_PROVIDER=nvidia
NVIDIA_DEFAULT_MODEL=meta/llama-3.3-70b-instruct

# NVIDIA NIM / AI Foundation API Accounts & Tokens
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=

# Google Gemini API (Fallback / Search Grounding)
GEMINI_API_KEY=

# Google Custom Search API (for web search without LLM involvement)
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# Supabase Auth & Database
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=